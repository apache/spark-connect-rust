# Coverage scope for the pyspark drop-in's hand-written Python shim.
# The bulk of the client is the compiled Rust extension (_pyspark); this measures
# the Python glue only, excluding vendored third-party code (cloudpickle), the
# test-support utilities, pandas-on-spark, generated wrappers, and the compiled
# extension itself.
# The embedded crates/pyspark-rs/src/row.py runs as pyspark/_row.py, values.py as
# pyspark/_values.py, and the setParams factory of the feature stages (ml/feature.rs) as
# pyspark/_ml_set_params.py. Those paths have no file and are explicitly omitted. The Row and
# value tests exercise their behavior; Ruff checks the embedded sources.
[run]
source = pyspark
branch = True
# The badge scopes to the core DataFrame/SQL drop-in shim exercised by the
# offline suite. Vendored third-party code (cloudpickle), generated wrappers,
# the compiled extension, and subsystems with their own (server-backed) tests
# rather than offline unit tests (streaming, resource, ml, the pickling
# serializers, datasource) are omitted so the number reflects the code this
# suite actually drives.
omit =
    # Vendored upstream code (byte-identical to Apache Spark, enforced by
    # scripts/check_vendored_upstream.sh; covered by Apache's own tests and by our dedicated
    # pandas/pipelines parity workflows, not this offline shim suite). Keep in sync with that
    # script's VENDORED_DIRS/VENDORED_FILES. What remains measured is the hand-written drop-in
    # glue (pyspark/sql/*.py shims and pyspark/sql/connect/* shims).
    */cloudpickle/*
    */pyspark/testing/*
    */pyspark/pandas/*
    */pyspark/ml/*
    */pyspark/mllib/*
    */pyspark/resource/*
    */pyspark/streaming/*
    */pyspark/pipelines/*
    */pyspark/logger/*
    */pyspark/errors/*
    */pyspark/messages/*
    */pyspark/sql/streaming/*
    # The drop-in's streaming code of the modules of PySpark Connect (the listener bus and the
    # functions of foreach), as that of pyspark.sql.streaming: the subsystem has its own tests.
    */pyspark/sql/connect/streaming/*
    */pyspark/sql/worker/*
    */pyspark/sql/plot/*
    */pyspark/sql/pandas/*
    */pyspark/sql/connect/functions/_generated.py
    */pyspark/sql/datasource.py
    */pyspark/sql/conversion.py
    */pyspark/sql/internal.py
    */pyspark/sql/variant_utils.py
    */pyspark/sql/datasource_internal.py
    */pyspark/sql/profiler.py
    */pyspark/sql/metrics.py
    */pyspark/sql/interchange.py
    */pyspark/sql/session.py
    */pyspark/sql/conf.py
    */pyspark/sql/tvf.py
    */pyspark/sql/merge.py
    */pyspark/sql/observation.py
    */pyspark/sql/context.py
    */pyspark/sql/catalog.py
    */pyspark/sql/readwriter.py
    */pyspark/sql/udf.py
    */pyspark/sql/udtf.py
    */pyspark/sql/group.py
    */pyspark/sql/pandas/group_ops.py
    */pyspark/sql/streaming/readwriter.py
    */pyspark/sql/streaming/query.py
    */pyspark/sql/column.py
    */pyspark/sql/table_arg.py
    */pyspark/sql/utils.py
    */pyspark/serializers.py
    */pyspark/loose_version.py
    */pyspark/_globals.py
    # Classic-Spark / JVM / launcher utilities that a Connect-only client never uses and
    # cannot exercise offline (SparkContext helpers, gateway launch, local-install discovery).
    */pyspark/util.py
    */pyspark/find_spark_home.py
    */pyspark/version.py
    */pyspark/accumulators.py
    */pyspark/profiler.py
    */pyspark/memory_profiler_ext.py
    */pyspark/worker_util.py
    */pyspark/instrumentation_utils.py
    # The logger and the types of the connect import path, vendored.
    */pyspark/sql/connect/logging.py
    */pyspark/sql/connect/_typing.py
    */pyspark/sql/connect/conversion.py
    # The other files that scripts/check_vendored_upstream.sh keeps byte-identical to the tag
    # (scripts/tests/test_coverage_scope.py checks that every vendored file is omitted here).
    */pyspark/conf.py
    */pyspark/taskcontext.py
    */pyspark/traceback_utils.py
    */pyspark/sql/geo_utils.py
    */pyspark/sql/sql_formatter.py
    */pyspark/sql/connect/profiler.py
    */pyspark/sql/connect/shell/progress.py
    */pyspark/sql/connect/resource/*
    */pyspark/sql/functions/*
    */pyspark/sql/connect/functions/partitioning.py
    */pyspark/sql/connect/avro/__init__.py
    */pyspark/sql/connect/protobuf/__init__.py
    */pyspark/sql/connect/streaming/__init__.py
    */pyspark/sql/connect/client/retries.py
    */pyspark/sql/connect/client/__init__.py
    # The native extension and its embedded Row and value sources, which have synthetic
    # filenames.
    */pyspark/_pyspark*
    */pyspark/_row.py
    */pyspark/_values.py
    */pyspark/_ml_set_params.py
    # Test helpers.
    */tests/*

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    raise PySparkNotImplementedError
    if __name__ == .__main__.:
    # Never executed at runtime: type-checking-only imports and optional-dependency guards.
    if TYPE_CHECKING:
    except ImportError:
